[Unit]
Description=Pulsar 2.0 Next.js web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pulsar
Group=pulsar
WorkingDirectory=/opt/pulsar2
Environment=NODE_ENV=production
EnvironmentFile=/etc/pulsar/pulsar.env
ExecStart=/usr/bin/npm run start -- -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/pulsar2/data /opt/pulsar2/.next/cache

[Install]
WantedBy=multi-user.target
