# Public origin used to build magic links. Do not add a trailing slash.
NEXT_PUBLIC_APP_URL=https://app.pulsar-cloud.space

# SQLite URL is resolved from the repository root by prisma.config.ts.
DATABASE_URL=file:./data/pulsar.db

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_TOKEN_SECRET=replace_me
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
OUTBOX_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

SESSION_COOKIE_NAME=pulsar_session
AUTH_OTP_TTL_SECONDS=600
AUTH_MAGIC_LINK_TTL_SECONDS=600
AUTH_SESSION_TTL_DAYS=180
AUTH_MAX_ATTEMPTS=5
AUTH_EMAIL_RATE_LIMIT=5
AUTH_IP_RATE_LIMIT=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RESEND_COOLDOWN_SECONDS=60

RESEND_API_KEY=re_replace_me
EMAIL_FROM="Pulsar <auth@pulsar-cloud.space>"
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=10

# Telegram OIDC login. Bot API token is optional unless the bot sends messages.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=@pulsarcloud_bot
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=https://app.pulsar-cloud.space/auth/telegram/callback
